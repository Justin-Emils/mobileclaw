# pnpm layout for a React Native monorepo on Windows.
#
# `node-linker=hoisted` matters for two independent reasons:
#
#  1. Metro does not resolve symlink-aware layouts the way plain Node does, so a
#     hoisted tree keeps it from seeing two copies of the same module.
#  2. Windows build paths. The default isolated layout nests every package under
#     `node_modules/.pnpm/<name>@<version>_<hash>/node_modules/<name>`, which costs
#     ~93 characters before the package name even starts. react-native-worklets'
#     CMake object path then reached 252 characters against CMake's 250-character
#     CMAKE_OBJECT_PATH_MAX limit, and the build failed with
#     "ninja: error: manifest 'build.ninja' still dirty after 100 tries".
#     Hoisting drops that to ~65, with plenty of headroom.
#
# This file must live at the workspace ROOT: pnpm reads .npmrc relative to where
# `pnpm install` runs, and an .npmrc inside apps/mobile is ignored — which is why
# the original app-level copy had no effect.
node-linker=hoisted
shamefully-hoist=true

# Shorten the dependency paths themselves.
#
# node-linker=hoisted is a no-op on pnpm 11, so packages still live under the
# isolated store — and that nest costs ~93 characters before the package name:
#   E:\code\mobileclaw\node_modules\.pnpm\react-native-worklets@0.13._82ad66a5…\node_modules\react-native-worklets
# react-native-worklets' CMake object path then reached 252 characters against
# CMake's 250-character CMAKE_OBJECT_PATH_MAX, and the C++ targets failed with
# "ninja: error: manifest 'build.ninja' still dirty after 100 tries".
#
# Moving the virtual store to a short absolute path removes ~90 characters, which
# is the difference between failing and building. It is a symlink farm only; the
# real files stay in the pnpm content-addressable store.
virtual-store-dir=E:\.pnp
