# pnpm layout for this React Native monorepo.
#
# These two keys are INERT on pnpm 11 — kept only as documentation of the intent,
# and because they cost nothing if a future pnpm restores them:
#
#   node-linker=hoisted   — would flatten node_modules, which Metro prefers and
#                           which shortens Windows build paths by ~120 characters.
#   shamefully-hoist=true — the companion flag.
#
# pnpm 11 ignores both, so packages stay under the isolated store:
#   <root>/node_modules/.pnpm/<name>@<version>_<hash>/node_modules/<name>
#
# That ~120-character prefix is why this project cannot be built locally on this
# machine: ninja's 260-character path limit is exceeded by Android's prefab/CMake
# paths no matter where the repo sits. Full analysis, including a table of what was
# tried and why it failed, is in docs/dev-environment.md.
#
# `virtual-store-dir=E:\.pnp` was also tried here and is likewise ignored by pnpm 11.
# It has been removed rather than left in place, so nobody mistakes it for a fix.

node-linker=hoisted
shamefully-hoist=true
