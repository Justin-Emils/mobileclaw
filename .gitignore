# Auto-commit job output (see eng/commit.ps1)
.logs/

# Android build toolchain installed beside the repository by eng/setup-toolchain.ps1
# (see eng/BUILD.md). Deliberately not committed: the SDK alone is several GB, Google's
# licence does not allow redistributing it, and the binaries are platform-specific.
/.toolchain/

# Local Metro bundle used by `pnpm bundle` to verify the app compiles
apps/mobile/.expo-export-check/

# Downloaded build artifacts (APKs are large and reproducible from EAS)
artifacts/

# Temporary build directory.
#
# Was committed by accident (61 files, 2.8 MB) and contained nothing worth keeping: JVM thread
# dumps (`jstack-*.txt`), Kotlin daemon logs and their `.lck`/`.alive` markers, and a throwaway
# `expo prebuild` output tree named after a hash. All of it is regenerated by the next build, and
# the daemon logs change on their own -- so tracking it produced diffs that had nothing to do
# with any code change.
.tmp-build/
